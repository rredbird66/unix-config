" linux-settings: управляемая конфигурация Vim.
" Файл-источник: vim/vimrc. Разворачивается командой make vim.
set nocompatible
syntax on
filetype plugin indent on
set backspace=indent,eol,start

" Отступы: четыре пробела.
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4

" Нумерация строк и тёмный фон.
set number
set background=dark
set laststatus=2
set noshowmode
if !has('gui_running')
   set t_Co=256
endif

" Встроенная тёмная тема; solarized8 и внешние плагины не нужны.
try
   colorscheme habamax
catch /^Vim\%((\a\+)\)\=:E185/
   colorscheme default
endtry

" Необязательный встроенный пакет Vim, если он есть в поставке.
silent! packadd matchit
