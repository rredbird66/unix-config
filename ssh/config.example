# Пример ~/.ssh/config для linux-settings. Только демонстрационные значения.
# Скопируйте нужные Host-блоки в ~/.ssh/config и замените адреса/пользователей.
# Глобального «User root» здесь намеренно нет.

Host targaryen
    HostName 192.0.2.10
    User demo
    Port 2222
    IdentityFile ~/.ssh/demo-targaryen.key

Host tyrell
    HostName 198.51.100.20
    User demo

Host martell
    HostName 203.0.113.50
    User demo

Host *ell
    User demo

Host * !martell
    LogLevel INFO

Host *
    Compression yes
